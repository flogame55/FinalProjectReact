# Supabase credentials (Get from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-seed

# DummyJSON products API (public API; no API key required)
DUMMYJSON_BASE_URL=https://dummyjson.com
# Used only if Frankfurter cannot provide the current USD/THB reference rate
USD_TO_THB_FALLBACK_RATE=33.62
